# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication
JWT_SECRET=your_jwt_secret_here
NEXTAUTH_URL=http://localhost:3000
